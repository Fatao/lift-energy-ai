# Copy to .env and edit. Everything is optional: with nothing set the app runs on demo data.

# ---- MQTT (live source) ---------------------------------------------------
# MQTT_URL=mqtt://localhost:1883
# MQTT_TOPIC=lifts/+/telemetry
# MQTT_USER=
# MQTT_PASSWORD=

# ---- Modbus RTU over RS-485 (live source) ---------------------------------
# Windows: COM3   Linux: /dev/ttyUSB0   RS-485 -> Ethernet gateway: socket://192.168.1.50:4001
# MODBUS_PORT=COM3
# MODBUS_BAUD=9600
# MODBUS_PARITY=N
# MODBUS_STOPBITS=1
# MODBUS_UNITS=L1=1,L2=2          # lift_id=slave address on the bus
# MODBUS_POLL_SECONDS=10
# MODBUS_WORD_ORDER=big           # big | little (order of 16-bit words inside 32-bit counters)
# MODBUS_REGMAP=regmap.json       # path to a JSON register map (see README)

# ---- LLM explanation layer (pick ONE) ---------------------------------------
# Secrets live ONLY in this local .env file. Never paste keys into chat, screenshots or git.
# LLM_PROVIDER=gemini             # Google AI Studio key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=<your key>
# GEMINI_MODEL=gemini-2.5-flash

# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# LLM_PROVIDER=gigachat
# GIGACHAT_AUTH_KEY=<Authorization key (Base64) from developers.sber.ru>   # = base64(ClientID:ClientSecret)
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat
# GIGACHAT_CA_BUNDLE=C:\certs\russian_trusted_root_ca.pem   # or GIGACHAT_VERIFY_SSL=false (testing only)

# LLM_PROVIDER=openai             # any OpenAI-compatible API (OpenRouter, Groq, LM Studio, ...)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=

# Safety limit for one energy sample (kWh); larger jumps are rejected as sensor glitches
# MAX_KWH_PER_SAMPLE=50
